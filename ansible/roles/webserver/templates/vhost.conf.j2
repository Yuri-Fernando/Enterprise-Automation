# {{ ansible_managed }}
# vhost gerado pela role webserver — Enterprise Cloud Automation Platform

server {
    listen {{ webserver_http_port }} default_server;
    server_name {{ webserver_server_name }};

    root {{ webserver_document_root }};
    index index.html index.htm;

    client_max_body_size {{ webserver_client_max_body_size }};

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

{% if webserver_security_headers_enabled %}
    # Cabeçalhos de segurança básicos.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{% endif %}

    # Endpoint de health check — sem logging, consumido por
    # automation/troubleshooting/health_check.py e pelo Load Balancer.
    location {{ webserver_healthcheck_path }} {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
