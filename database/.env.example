# Copie este arquivo para `.env` (mesma pasta) antes de rodar
# `docker compose up -d`. O `.env` real NUNCA deve ser commitado
# (já está coberto pelo .gitignore da raiz do projeto).

# Senha do usuário root do MySQL (obrigatória pela imagem mysql:8)
MYSQL_ROOT_PASSWORD=change_me_root

# Database criado automaticamente no primeiro start
MYSQL_DATABASE=caterpillar_automation

# Usuário de aplicação (não-root) criado automaticamente no primeiro start
MYSQL_USER=automation_app
MYSQL_PASSWORD=change_me_app

# Porta exposta no host (mapeada para 3306 dentro do container)
MYSQL_PORT=3306
